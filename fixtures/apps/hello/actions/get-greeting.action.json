{
  "manifestVersion": "1",
  "key": "get-greeting",
  "type": "read",
  "title": "Get Greeting",
  "description": "Returns a greeting for the given name.",
  "params": [
    {
      "key": "name",
      "label": "Name",
      "type": "string",
      "required": true,
      "validation": { "minLength": 1, "maxLength": 50 }
    },
    {
      "key": "excited",
      "label": "Excited",
      "type": "boolean",
      "default": false
    }
  ],
  "execute": "./get-greeting.ts",
  "output": [
    { "key": "greeting", "type": "string", "label": "Greeting" }
  ]
}

{
  "manifestVersion": "1",
  "key": "oauth",
  "type": "oauth2",
  "displayName": "Sign in with Slack",
  "oauth2": {
    "authorizationUrl": "https://slack.com/oauth/v2/authorize",
    "tokenUrl": "https://slack.com/api/oauth.v2.access",
    "scopes": ["chat:write", "channels:read"],
    "pkce": true
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w6w.io/schemas/v1/auth.schema.json",
  "title": "Auth",
  "description": "How a user connects their account to an App.",
  "type": "object",
  "required": ["type", "displayName"],
  "properties": {
    "manifestVersion": { "type": "string", "minLength": 1 },
    "key": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "type": { "type": "string", "enum": ["oauth2", "apiKey", "basic", "bearer", "custom"] },
    "displayName": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "connectionLabel": { "type": "string" },
    "fields": { "type": "array", "items": { "$ref": "param.schema.json" } },
    "hooks": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
    "oauth2": {
      "type": "object",
      "required": ["authorizationUrl", "tokenUrl"],
      "additionalProperties": false,
      "properties": {
        "authorizationUrl": { "type": "string", "minLength": 1 },
        "tokenUrl": { "type": "string", "minLength": 1 },
        "refreshUrl": { "type": "string", "minLength": 1 },
        "revokeUrl": { "type": "string", "minLength": 1 },
        "scopes": { "type": "array", "items": { "type": "string" } },
        "scopeSeparator": { "type": "string" },
        "pkce": { "type": "boolean" },
        "extraAuthParams": { "type": "object" }
      }
    },
    "apiKey": {
      "type": "object",
      "required": ["in", "name"],
      "additionalProperties": false,
      "properties": {
        "in": { "type": "string", "enum": ["header", "query", "body"] },
        "name": { "type": "string", "minLength": 1 },
        "prefix": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "oauth2" } }, "required": ["type"] },
      "then": { "required": ["oauth2"] }
    },
    {
      "if": { "properties": { "type": { "const": "apiKey" } }, "required": ["type"] },
      "then": { "required": ["apiKey"] }
    }
  ]
}

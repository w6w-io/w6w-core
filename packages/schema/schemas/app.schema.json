{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w6w.io/schemas/v1/app.schema.json",
  "title": "App",
  "description": "Unit of integration — identity, presentation, and provenance of an integrated service.",
  "type": "object",
  "required": [
    "manifestVersion",
    "id",
    "name",
    "displayName",
    "version",
    "description",
    "categories",
    "appearance",
    "author",
    "license"
  ],
  "properties": {
    "manifestVersion": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$" },
    "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "displayName": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+].*)?$" },
    "appVersion": { "type": "string", "minLength": 1 },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maturity": { "type": "string", "enum": ["alpha", "beta", "stable", "deprecated"] },
        "visibility": { "type": "string", "enum": ["private", "unlisted", "public"] },
        "successor": { "type": "string", "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$" }
      }
    },
    "assetsRoot": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1, "maxLength": 200 },
    "longDescription": { "type": "string", "minLength": 1 },
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "type": "string", "minLength": 1 }
    },
    "keywords": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "appearance": {
      "type": "object",
      "required": ["icon"],
      "additionalProperties": false,
      "properties": {
        "icon": { "$ref": "image-object.schema.json" },
        "brandColor": {
          "type": "string",
          "pattern": "^#([0-9A-Fa-f]{3,4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$"
        },
        "darkMode": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "icon": { "$ref": "image-object.schema.json" },
            "brandColor": {
              "type": "string",
              "pattern": "^#([0-9A-Fa-f]{3,4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$"
            }
          }
        }
      }
    },
    "screenshots": {
      "type": "array",
      "items": { "$ref": "image-object.schema.json" }
    },
    "author": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 }
      }
    },
    "publisher": { "type": "string", "minLength": 1 },
    "homepage": { "type": "string", "minLength": 1 },
    "repository": { "type": "string", "minLength": 1 },
    "documentation": { "type": "string", "minLength": 1 },
    "support": { "type": "string", "minLength": 1 },
    "bugs": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "privacyPolicy": { "type": "string", "minLength": 1 },
    "termsOfService": { "type": "string", "minLength": 1 },
    "defaultLocale": { "type": "string", "minLength": 1 },
    "localizations": {
      "type": "object",
      "additionalProperties": { "type": "object" }
    },
    "engines": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}

{
  "workspace": [
    "./packages/types",
    "./packages/runtime",
    "./packages/sources",
    "./packages/validator",
    "./packages/expr",
    "./packages/schema"
  ],
  "imports": {
    "@w6w/types": "./packages/types/mod.ts"
  },
  "tasks": {
    "test": "deno test -A --unstable-worker-options packages/",
    "check": "deno check packages/",
    "fmt": "deno fmt packages/",
    "lint": "deno lint packages/",
    "validate": "deno run --allow-read packages/validator/cli.ts"
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
